#REST

## Variables
@base_url = http://localhost:{{$dotenv APP_PORT}}
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@admin_firstname = {{$dotenv ADMIN_FIRSTNAME}}
@admin_lastname = {{$dotenv ADMIN_LASTNAME}}
@user_firstname = {{$dotenv USER_FIRSTNAME}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}
@user_jwt_token_stu = {{$dotenv USER_JWT_TOKEN_STU}}
@user_create_name_stu = {{$dotenv USER_CREATE_NAME_STU}}
@user_create_mobile_stu = {{$dotenv USER_CREATE_MOBILE_STU}}
@user_create_card_id_stu = {{$dotenv USER_CREATE_CARD_ID_STU}}
@user_update_name_stu = {{$dotenv USER_UPDATE_NAME_STU}}
@user_update_mobile_stu = {{$dotenv USER_UPDATE_MOBILE_STU}}
@user_update_card_id_stu = {{$dotenv USER_UPDATE_CARD_ID_STU}}
@subject_name = {{$dotenv SUBJECT_NAME}}
@subject_update_name = {{$dotenv SUBJECT_UPDATE_NAME}}
@teacher_name = {{$dotenv TEACHER_NAME}}
@teacher_update_name = {{$dotenv TEACHER_UPDATE_NAME}}
@reset_password_code = {{$dotenv RESET_PASSWORD_CODE}}

#1.Admin
##1.1 login
POST {{base_url}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": true
}

### 1.2 Register
POST {{base_url}}/admin/register-admin
Content-Type: application/json

    {
        "email": "{{admin_email}}",
        "firstname": "{{admin_firstname}}",
        "lastname": "{{admin_lastname}}",
        "password": "{{admin_password}}"
    }

### 1.3Forgot Password
# Response is now 204 (no token returned).
# The reset link is sent to the admin's email - view it in MailHog UI: http://localhost:8025
POST {{base_url}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
# resetPasswordToken = "code" query param from the reset link in the MailHog email
# (token arrives in the email, not from .env)
POST {{base_url}}/admin/reset-password
Content-Type: application/json

{
    "password": "{{admin_password}}"
}

### 1.4 Profile
# Paste an admin JWT below
GET {{base_url}}/admin/users/me
Authorization: Bearer <admin-jwt>
Content-Type: application/json

#2. User
### 2.1 Login
POST {{base_url}}/api/auth/local/
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

# {%
#     client.global.set("user_jwt", response.body.jwt);
# %}

### 2.2 Register
POST {{base_url}}/api/auth/local/register
Content-Type: application/json

{
    "email": "{{user_email}}",
    "username": "{{user_firstname}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
# Response is now 204 (no token returned).
# The reset code is sent to the user's email - view it in MailHog UI: http://localhost:8025
POST {{base_url}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password
# code = the reset code shown in the MailHog email
POST {{base_url}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{reset_password_code}}",
    "password": "{{user_password}}",
    "passwordConfirmation": "{{user_password}}"
}

### 2.4 Profile
# Uses the token captured in 2.1
GET {{base_url}}/api/users/me
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

## 3. Content
## 3.1 Student
### 3.1.1 List All Students
GET {{base_url}}/api/students
Authorization: Bearer {{user_jwt_token_stu}}

### 3.1.2 List Student with ID
GET {{base_url}}/api/students/2
Authorization: Bearer {{user_jwt_token_stu}}

#### 3.1.3 Update Student
PUT {{base_url}}/api/students/2
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

{
    "data": {
        "name": "{{user_update_name_stu}}",
        "mobile": "{{user_update_mobile_stu}}",
        "cardId": "{{user_update_card_id_stu}}"
    }
}

#### 3.1.4 Create Student
POST {{base_url}}/api/students
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

{
    "data": {
        "name": "{{user_create_name_stu}}",
        "mobile": "{{user_create_mobile_stu}}",
        "cardId": "{{user_create_card_id_stu}}"
    }
}

#### 3.1.5 Delete Student
DELETE {{base_url}}/api/students/2
Authorization: Bearer {{user_jwt_token_stu}}


### 3.2 Subject
#### 3.2.1 Create Subject
POST {{base_url}}/api/subjects
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

{
    "data": {
        "name": "{{subject_name}}"
    }
}

#### 3.2.2 List All Subjects
GET {{base_url}}/api/subjects
Authorization: Bearer {{user_jwt_token_stu}}

#### 3.2.3 List Subject with ID
# <subject-id> is the "id" returned by Create / List All
GET {{base_url}}/api/subjects/1
Authorization: Bearer {{user_jwt_token_stu}}

#### 3.2.4 Update Subject
PUT {{base_url}}/api/subjects/1
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

{
    "data": {
        "name": "{{subject_update_name}}"
    }
}

#### 3.2.5 Delete Subject
DELETE {{base_url}}/api/subjects/1
Authorization: Bearer {{user_jwt_token_stu}}

### 3.3 Teacher
#### 3.3.1 Create Teacher
POST {{base_url}}/api/teachers
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

{
    "data": {
        "name": "{{teacher_name}}"
    }
}

#### 3.3.2 List All Teachers
GET {{base_url}}/api/teachers
Authorization: Bearer {{user_jwt_token_stu}}

#### 3.3.3 List Teacher with ID
# <teacher-id> is the "id" returned by Create / List All
GET {{base_url}}/api/teachers/1
Authorization: Bearer {{user_jwt_token_stu}}

#### 3.3.4 Update Teacher
PUT {{base_url}}/api/teachers/1
Authorization: Bearer {{user_jwt_token_stu}}
Content-Type: application/json

{
    "data": {
        "name": "{{teacher_update_name}}"
    }
}

#### 3.3.5 Delete Teacher
DELETE {{base_url}}/api/teachers/1
Authorization: Bearer {{user_jwt_token_stu}}